# Copy to .env.local for local development. Never commit .env.local.
# Secret key from Scaleway: IAM & API keys > Generate API key
AI_API_KEY=
# Optional
AI_MODEL=gemma-4-26b-a4b-it
AI_BASE_URL=https://api.scaleway.ai/v1

# Free-token limit. Production refuses to call the model unless a shared counter is configured,
# and stops at the budget (default 900000, under Scaleway's 1,000,000 free tokens). "off" removes the limit.
# AI_TOKEN_BUDGET=900000
# Set automatically when you add Upstash for Redis from the Vercel Marketplace:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
